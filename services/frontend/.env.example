# Public URL for the platform API used by the browser.
# Vite only exposes variables prefixed with VITE_ to frontend code.
VITE_PLATFORM_API_URL=http://localhost:8080
VITE_AUTH_BASE_URL=http://localhost:3000
VITE_GRAFANA_URL=https://grafana.edinstance.uk
VITE_MOCK_PLATFORM=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-better-auth-secret
PLATFORM_ADMIN_PASSWORD=replace-with-admin-password
PLATFORM_AUTH_ISSUER=http://localhost:3000
PLATFORM_AUTH_AUDIENCE=platform-api
